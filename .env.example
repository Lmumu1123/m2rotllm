# Copy this file to .env and replace paths with locations on your server.
# Relative paths are resolved from the repository root by the provided scripts.

RotLLM_WEIGHTS=./weights
DATASET_METADATA_PATH=./datasets/vibration_metadata.sqlite
DCN_DATASET_PATH=./data/data.hdf5
TIME_DATASET_PATH=./data/time_data.hdf5
LOG_PATH=./logs
QWEN_WEIGHTS=./qwen_weights
RAW_DATASET_DIR=./raw_datasets/npy
PUBLIC_BEARING_DATASET_PATH=./raw_datasets/public_bearing
PUBLIC_GEAR_DATASET_PATH=./raw_datasets/public_gear
DATASET_FILE_INFO_PATH=./raw_datasets/file_info.csv
DATASET_CONDITION_PATH=./raw_datasets/condition.csv

# MBHM adapter inputs. data.hdf5 contains the `vibration` dataset.
MBHM_DIR=./mbhm_dataset
MBHM_METADATA_PATH=./mbhm_dataset/metadata.sqlite
MBHM_DCN_DATASET_PATH=./mbhm_dataset/data.hdf5

# Optional font used by Chinese diagnostic plots.
# ALIGNMENT_FONT=/path/to/wqy-microhei.ttc
